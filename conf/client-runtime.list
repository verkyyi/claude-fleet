bin/fleet-ui-lang.sh	status
bin/fleet_notice.py	static
bin/fleet-notice.sh	static
conf/fleet-palette.conf	static
bin/fleet-iterm-profile.py	view
bin/fleet_keys.py	view
bin/dash-keymap.sh	static
conf/vendor-tmux.lock	install:read
conf/secret-shapes.list	view:read,ls:read,show:read,answer:read,connect:read
