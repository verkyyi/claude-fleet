# conf/client-runtime.list — the client package's files a client-only computer
# really uses (issue #4824, EPIC #4823 C1): <path> TAB <the actions that used it>.
# Made by bin/fleet-client-runtime.sh (trace on Linux under strace, then build);
# `<action>:read` = only read as data there; `static` = named in a file that ran,
# on a branch no action took.
# `agent` / `dispatch` (issue #4826) are written by hand: the node agent runs it,
# a `fleet <word>` no traced action takes.
# bin/fleet-client-runtime.sh --check holds this list and fleetclient/manifest
# together both ways: every path here is in the manifest, every file it
# installs is here (EPIC #4823 C3).
bin/fleet-install.sh	static
bin/fleet	help,status,update,doctor,login,logout,host-on,view,ls,show,answer,connect,doctor-live,update-live
bin/fleet-login.py	login,view,ls,show,answer,connect,doctor-live
bin/fleet-node.sh	static
bin/fleet-node-leave.sh	static
bin/fleet-logout.sh	logout
bin/fleet-host.sh	host-on
bin/fleet-host-install.sh	static
bin/fleet-connect.py	doctor,view,ls,show,answer,connect,doctor-live
bin/fleet-route.py	dispatch
bin/fleet_tls.py	install,doctor,login,view,ls,show,answer,connect,doctor-live
bin/fleet_clientlog.py	doctor,login,view,ls,show,answer,connect,doctor-live
bin/fleet_client_events.py	view
bin/fleet_managed.py	login,view,ls,show,answer,connect,doctor-live
bin/fleet_redact.py	install:read,doctor:read,doctor-live:read
bin/fleet-client-lib.sh	static
bin/fleet-client-update.sh	doctor,view,doctor-live
bin/fleet-versions-lib.sh	install,doctor,host-on,view,ls,show,answer,doctor-live
bin/fleet-update.sh	update,update-live
bin/fleet-client-retire.sh	status,doctor,view,doctor-live
bin/fleet-client-who.sh	status
bin/fleet-client-lease.py	view
bin/fleet-client-actions.py	static
bin/fleet-client-upload.py	view
bin/fleet-upload-receive.py	static
bin/fleet-thin.py	view,ls,show,answer
bin/fleet-thin-upload.py	view
bin/fleet-shell.py	dispatch
bin/fleet_open_fwd.py	static
bin/fleet-client-where.sh	static
