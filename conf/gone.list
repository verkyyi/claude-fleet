path bin/fleet-pick.sh                 #1034
re   range=user\|xfleet                #980   conf/tmux-attention.conf,conf/tmux-bar.conf
word attn_other_windows                #980   conf/tmux-attention.conf,conf/tmux-bar.conf
word fleet-pick                        #980   bin/fleet-attach.sh
