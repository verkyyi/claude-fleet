# conf/secret-shapes.list — the ONE table of what a credential looks like
# (EPIC #2889 共同约定 1; created by C7 #2896, extended by C1 #2890 — the
# rows and the two `#@` directives at the end).
#
# One shape per line: <name><TAB><POSIX ERE>. A match is replaced with
# `<redacted:<name>>`, shapes applied top to bottom, each over the whole line.
# Every reader reads THIS file — never a copy of a pattern:
#   · bin/fleet_clientlog.py          (Python `re`)  the client's own logs (C7)
#   · fleet_clientlog in bin/fleet-client-lib.sh (awk) the same, from sh (C7)
#   · C1's bundle redactor (Python + awk), C3's upload check
# so a pattern must mean the same thing to Python's `re` and to BSD / GNU awk:
#   · no backslash at all (awk unescapes a dynamic regex once more; Python
#     reads `\d` `\s` `\b` that awk does not) — spell a class out: [0-9]
#   · no {m,n} interval (an older BSD awk has none) — use + and *
#   · no (?i) — case goes in brackets: [Tt][Oo][Kk][Ee][Nn]
#   · no lookaround, no lazy quantifier, no [[:class:]] (Python has none)
#   · an alternation only where one branch at most can match at a spot —
#     Python takes the first branch that matches, POSIX the longest
# bin/client-log-selftest.sh holds every line to these rules and runs both
# readers over one corpus, byte for byte.
#
# Fields only grow: a name never changes meaning (it is in every redacted log).

github	gh[pousr]_[A-Za-z0-9]+
github_pat	github_pat_[A-Za-z0-9_]+
anthropic	sk-ant-[A-Za-z0-9_-]+
private_key	-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[A-Za-z0-9+/= ]*(-----END [A-Z0-9 ]*PRIVATE KEY-----)?
authorization	[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]:[ ]*[^ ,;]+( [^ ,;"]+)?
cookie	[Cc][Oo][Oo][Kk][Ii][Ee]:[ ]*[^ ]+
bearer	[Bb][Ee][Aa][Rr][Ee][Rr] [A-Za-z0-9._~+/=-]+
url_query	[?&]([Tt][Oo][Kk][Ee][Nn]|[Aa][Cc][Cc][Ee][Ss][Ss]_[Tt][Oo][Kk][Ee][Nn]|[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Ii][Gg]|[Ss][Ii][Gg][Nn][Aa][Tt][Uu][Rr][Ee])=[^&#" ]+
env_secret	[A-Za-z0-9_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd])[A-Za-z0-9_]*=[^ ,;"]+
json_token	"[A-Za-z_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd])"[ ]*:[ ]*"[^"]*"

# ── C1 (#2890): what the diagnosis bundle (fleet doctor --bundle) adds ──
gitlab	glpat-[A-Za-z0-9_-]+
slack	xox[abprs]-[A-Za-z0-9-]+
aws	AKIA[0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z]
google	AIza[0-9A-Za-z_-]+
jwt	eyJ[A-Za-z0-9_-]+[.]eyJ[A-Za-z0-9_-]+([.][A-Za-z0-9_-]+)?
fleet_debug_ticket	(FleetDebug|fleet-debug ticket) [^ ]+
url_secret	[?&][A-Za-z_]*([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Oo][Dd][Ee]|[Aa][Pp][Ii]_?[Kk][Ee][Yy])=[^&#" ]+
env_key	[A-Za-z0-9_]*([Aa][Pp][Ii]_?[Kk][Ee][Yy]|_KEY)[A-Za-z0-9_]*=[^ ,;"']+
env_secret_quoted	[A-Za-z0-9_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Aa][Pp][Ii]_?[Kk][Ee][Yy]|_KEY)[A-Za-z0-9_]*=("[^"]*"|'[^']*')
#
# Two directives, comment lines to every reader but bin/fleet_redact.py and
# bin/fleet-redact.awk (C1):
#   #@block <TAB> <name> <TAB> <begin ERE> <TAB> <end ERE>
#       a begin with no end on its line: the rest of that line, every line up to
#       the end and the end itself become one <redacted:name> (a PEM key across
#       lines — the client's logs are one line a record and never see one)
#   #@scan <TAB> <names>
#       the rows fleet-agent-team.py's config scan treats as a credential VALUE
#       (a context shape — KEY=…, a header — is not a value)
#@block	private_key	-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----	-----END [A-Z0-9 ]*PRIVATE KEY-----
#@scan	github github_pat anthropic private_key bearer gitlab slack aws google jwt
