# conf/secret-shapes.list — the ONE table of what a credential looks like
# (issue #2890, EPIC #2889 C1; 共同约定第 1 条). Read by bin/fleet_redact.py and
# bin/fleet-redact.awk (byte-identical output — doctor-bundle-selftest.sh pins it),
# and by bin/fleet-agent-team.py's credential scan (its `value` and `block` rows).
# A new kind of credential is ONE row here, never a second list elsewhere.
#
# One row:  <name> TAB <kind> TAB <ERE> [TAB <end ERE>]
#   value  a token-shaped value; a match must not follow a letter, digit or `_`
#          (the `\b` neither awk nor ERE has)
#   text   a context shape (a header, a KEY=value) — matched anywhere
#   block  lines from <ERE> through <end ERE> become one <redacted:name>
# A match is replaced by `<redacted:<name>>`; rows apply in this order.
#
# The ERE is the subset Python's `re` (bytes) and BSD awk read the same:
# [...] classes, ( | ), * + ? and {n,} — never `\`, `^` or `$`. Case-insensitive
# is spelled [Tt][Oo]…. Python takes the greedy match, awk the longest: write a
# shape so the two are the same span (it ends in a greedy run of what it eats).
anthropic-key	value	sk-ant-[A-Za-z0-9_-]{8,}
openai-key	value	sk-[A-Za-z0-9_-]{20,}
github-token	value	gh[pousr]_[A-Za-z0-9]{20,}
github-pat	value	github_pat_[A-Za-z0-9_]{20,}
gitlab-token	value	glpat-[A-Za-z0-9_-]{20,}
slack-token	value	xox[abprs]-[A-Za-z0-9-]{10,}
aws-key	value	AKIA[0-9A-Z]{16}
google-key	value	AIza[0-9A-Za-z_-]{30,}
jwt	value	eyJ[A-Za-z0-9_-]{10,}[.]eyJ[A-Za-z0-9_-]{10,}([.][A-Za-z0-9_-]*)?
bearer	value	[Bb][Ee][Aa][Rr][Ee][Rr] +[A-Za-z0-9._~+/=-]{16,}
private-key	block	-----BEGIN [A-Z ]*PRIVATE KEY-----	-----END [A-Z ]*PRIVATE KEY-----
auth-header	text	[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]: *.*
cookie-header	text	([Ss][Ee][Tt]-)?[Cc][Oo][Oo][Kk][Ii][Ee]: *.*
fleet-debug-ticket	text	(FleetDebug|fleet-debug ticket) +[^ ]+
url-secret	text	[?&][A-Za-z_]*([Tt][Oo][Kk][Ee][Nn]|[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Ii][Gg]|[Pp][Aa][Ss][Ss][Ww][Oo]?[Rr][Dd]|[Cc][Oo][Dd][Ee])[A-Za-z_]*=[^&# "']*
env-secret	text	[A-Za-z0-9_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo]?[Rr][Dd]|[Aa][Pp][Ii]_?[Kk][Ee][Yy]|_KEY)[A-Za-z0-9_]*=("[^"]*"|'[^']*'|[^ "']+)
json-secret	text	"[A-Za-z_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo]?[Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll])[A-Za-z_]*" *: *"[^"]*"
