{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/fleet/bin/set-claude-state.sh busy" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/fleet/hooks/bash-guard.py" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/fleet/hooks/base-readonly-guard.py" }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/fleet/hooks/artifact-guard.py" }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/fleet/hooks/agent-guard.py" }
        ]
      },
      {
        "matcher": "mcp__fleet__fleet_status|mcp__fleet__fleet_spawn|mcp__fleet__fleet_await",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/fleet/hooks/bash-guard.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/fleet/bin/set-claude-state.sh working" }
        ]
      },
      {
        "matcher": "ScheduleWakeup|CronCreate|CronDelete",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/fleet/bin/fleet_loop_mark.py hook" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/fleet/bin/set-claude-state.sh working" },
          { "type": "command", "command": "bash ~/.claude/fleet/bin/fleet-whats-new.sh --hook" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/fleet/bin/set-claude-state.sh needs bell" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/fleet/bin/set-claude-state.sh done" },
          { "type": "command", "command": "python3 ~/.claude/fleet/bin/fleet-codex-session.py hook" },
          { "type": "command", "command": "sh ~/.claude/fleet/bin/classify-hook.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/fleet/bin/handoff-latch-reset-hook.sh" },
          { "type": "command", "command": "python3 ~/.claude/fleet/bin/fleet-codex-session.py hook" },
          { "type": "command", "command": "bash ~/.claude/fleet/bin/fleet-emit.sh session.start --stdin-json" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/fleet/bin/refocus-hook.sh" }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/fleet/bin/fleet-history.sh resumed --stdin-json" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/fleet/bin/precompact-hook.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "prompt_input_exit|logout",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/fleet/bin/session-end-hook.sh" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/fleet/bin/fleet-emit.sh session.end --via hook --stdin-json" }
        ]
      }
    ]
  }
}
