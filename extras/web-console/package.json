{
  "name": "fleet-web-console",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p . && vite build --mode app && vite build --mode admin",
    "build:app": "vite build --mode app",
    "build:proto": "vite build --mode proto && node proto/inline.mjs",
    "dev": "vite --mode app --host 127.0.0.1",
    "build:admin": "vite build --mode admin",
    "dev:admin": "vite --mode admin --host 127.0.0.1"
  },
  "dependencies": {
