#!/bin/sh
# fleet [machine] | fleet <command> [args] — the client-side entry point a
# person types on their own computer (claude-fleet#1413, #1470).
#
#   fleet                       sign in if needed (QR once; the device renews
#                               after that), let the hub pick your machine —
#                               and open the SHELL (#1484, the default): the
#                               hub's list on the left, its bar at the bottom,
#                               a direct ssh into that machine on the right
#   fleet m4                    the same, into a machine you name; any more
#                               words (fleet m4 --print, -v) are connect's —
#                               the direct way, as is a fleet with no terminal
#   fleet shell [m4]            the shell, explicitly (fleet-shell.sh)
#   fleet login                 scan for a 12-hour connection certificate
#   fleet login renew           renew it with this device's key, no scan
#   fleet connect [machine]     measure every route, ssh in over the best
#   fleet connect --proxy <m>   ssh's ProxyCommand through the hub
#
# The shell is the default; ssh into the machine's own list is the FALLBACK, and
# only on one of four (issue #1628): no tmux here or one older than 3.2, an iPad
# or iPhone, the shell failing to start, or you asking for it (`fleet connect`,
# FLEET_SHELL=0). A fallback says why — one line here, and the same line on the
# far bar: 直连 m5（本地壳不可用：<reason>）(fleet-connect.py carries it over ssh).
#
# Each command is its own script beside this one, `fleet-<command>.py` or
# `fleet-<command>.sh`, so adding one is adding a file, not editing here. A
# first word that is not a command is a machine name.
here=$(cd "$(dirname "$0")" && pwd -P)
# shell_ok — may the shell open here? No: WHY says the fallback's reason ('' for
# a pipe or a script, which gets the direct way silently — the shell is a tmux
# client and needs a terminal; the selftest seam FLEET_SHELL_NO_ATTACH=1 starts
# the server without attaching, so it needs none).
shell_ok() {
  WHY=''
  if [ "${FLEET_SHELL:-1}" = 0 ]; then WHY='你设了 FLEET_SHELL=0'; return 1; fi
  [ -x "$here/fleet-shell.sh" ] || { WHY='没装 fleet-shell.sh'; return 1; }
  case $(uname -m 2>/dev/null) in
    iPad*) WHY='iPad 上没有本地壳'; return 1 ;;
    iPhone*|iPod*) WHY='iPhone 上没有本地壳'; return 1 ;;
  esac
  if [ "${FLEET_SHELL_NO_ATTACH:-0}" != 1 ]; then
    [ -t 0 ] && [ -t 1 ] || return 1
  fi
  if ! command -v tmux >/dev/null 2>&1; then
    echo 'fleet · 装上 tmux 就是这套壳（左边列表、底下一栏、右边直连）：macOS `brew install tmux`，Debian/Ubuntu `sudo apt install tmux`；先按今天的方式直连。' >&2
    WHY='没有 tmux'; return 1
  fi
  v=$(tmux -V 2>/dev/null); v=${v#tmux }; maj=${v%%.*}; min=${v#*.}; min=${min%%[!0-9]*}
  WHY="tmux ${v:-?} 太旧（要 ≥ 3.2）"
  case $maj in ''|*[!0-9]*) return 1 ;; esac
  [ "$maj" -gt 3 ] && { WHY=''; return 0; }
  [ "$maj" -eq 3 ] || return 1
  case $min in ''|*[!0-9]*) return 1 ;; esac
  [ "$min" -ge 2 ] || return 1
  WHY=''
}
# direct [args…] — the fallback: `fleet connect --enter`, carrying WHY
direct() {
  [ -n "$WHY" ] && { FLEET_FALLBACK_REASON=$WHY; export FLEET_FALLBACK_REASON; }
  exec "$here/fleet-connect.py" --enter "$@"
}
# shell [machine] — the shell; when it fails BEFORE attaching (it writes why to
# FLEET_SHELL_FAIL_FILE, then exits non-zero), the direct way, saying so. An
# exit after the attach — or one with nothing written — is the shell's own.
shell() {
  ff=$(mktemp "${TMPDIR:-/tmp}/fleet-shell.XXXXXX" 2>/dev/null) || exec "$here/fleet-shell.sh" "$@"
  FLEET_SHELL_FAIL_FILE=$ff "$here/fleet-shell.sh" "$@"; rc=$?
  why=$(cat "$ff" 2>/dev/null); rm -f "$ff"
  [ "$rc" -ne 0 ] && [ -n "$why" ] || exit "$rc"
  echo "fleet · 本地壳起不来（${why}），改为直连" >&2
  WHY="壳起不来：${why}"
  direct "$@"
}
cmd=${1-}
case $cmd in
  -h|--help|help)
    sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  '')
    shell_ok && shell
    direct ;;
  -*)
    exec "$here/fleet-connect.py" --enter "$@" ;;
  connect)
    # you asked for the direct way: its bar says so (not --proxy: no ssh of its own)
    FLEET_FALLBACK_REASON='你选了直连（fleet connect）'; export FLEET_FALLBACK_REASON ;;
esac
for ext in py sh; do
  if [ -x "$here/fleet-$cmd.$ext" ]; then
    shift
    exec "$here/fleet-$cmd.$ext" "$@"
  fi
done
# one word = a machine → the shell; more words are connect's own options
if [ $# -eq 1 ]; then
  shell_ok && shell "$@"
  direct "$@"
fi
exec "$here/fleet-connect.py" --enter "$@"
