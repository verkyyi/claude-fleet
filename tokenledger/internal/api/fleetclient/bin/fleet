#!/bin/sh
# fleet [machine] | fleet <command> [args] — the client-side entry point a
# person types on their own computer (claude-fleet#1413, #1470).
#
#   fleet                       sign in if needed (QR once; the device renews
#                               after that), let the hub pick your machine —
#                               and, with tmux ≥ 3.2 here, open the SHELL
#                               (#1484): the hub's list on the left, its bar at
#                               the bottom, a direct ssh into that machine on
#                               the right; no tmux (or FLEET_SHELL=0): measure
#                               the routes and ssh in, as before      (#1470)
#   fleet m4                    the same, into a machine you name; any more
#                               words (fleet m4 --print, -v) are connect's —
#                               the direct way, as is a fleet with no terminal
#   fleet shell [m4]            the shell, explicitly (fleet-shell.sh)
#   fleet login                 scan for a 12-hour connection certificate
#   fleet login renew           renew it with this device's key, no scan
#   fleet connect [machine]     measure every route, ssh in over the best
#   fleet connect --proxy <m>   ssh's ProxyCommand through the hub
#
# Each command is its own script beside this one, `fleet-<command>.py` or
# `fleet-<command>.sh`, so adding one is adding a file, not editing here. A
# first word that is not a command is a machine name.
here=$(cd "$(dirname "$0")" && pwd -P)
# The shell (#1484) is the way in when tmux ≥ 3.2 is here and FLEET_SHELL is not
# 0; with no tmux at all, one line says how to get it, then the direct way in.
# It is a tmux client, so it needs a terminal: a pipe or a script gets the
# direct way, silently (the selftest seam FLEET_SHELL_NO_ATTACH=1 starts the
# server without attaching, so it needs none).
shell_ok() {
  [ "${FLEET_SHELL:-1}" != 0 ] || return 1
  [ -x "$here/fleet-shell.sh" ] || return 1
  if [ "${FLEET_SHELL_NO_ATTACH:-0}" != 1 ]; then
    [ -t 0 ] && [ -t 1 ] || return 1
  fi
  if ! command -v tmux >/dev/null 2>&1; then
    echo 'fleet · 装上 tmux 就是这套壳（左边列表、底下一栏、右边直连）：macOS `brew install tmux`，Debian/Ubuntu `sudo apt install tmux`；先按今天的方式直连。' >&2
    return 1
  fi
  v=$(tmux -V 2>/dev/null); v=${v#tmux }; maj=${v%%.*}; min=${v#*.}; min=${min%%[!0-9]*}
  case $maj in ''|*[!0-9]*) return 1 ;; esac
  [ "$maj" -gt 3 ] && return 0
  [ "$maj" -eq 3 ] || return 1
  case $min in ''|*[!0-9]*) return 1 ;; esac
  [ "$min" -ge 2 ]
}
# The machine's ONE config file (issue #1623): a client that still keeps its
# settings the old way (shell.conf, hub.json's url) folds them in once, here —
# each old file kept as .bak. Two file tests when there is nothing to do.
cdir=${FLEET_CONF_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-fleet}
if [ ! -f "$cdir/fleet.conf" ] && { [ -f "$cdir/shell.conf" ] || [ -f "$cdir/hub.json" ]; } \
   && [ -f "$here/fleet-conf.sh" ]; then
  FLEET_CONF_DIR=$cdir bash "$here/fleet-conf.sh" migrate --quiet >&2 || :
fi
cmd=${1-}
case $cmd in
  -h|--help|help)
    sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  '')
    shell_ok && exec "$here/fleet-shell.sh"
    exec "$here/fleet-connect.py" --enter ;;
  -*)
    exec "$here/fleet-connect.py" --enter "$@" ;;
esac
for ext in py sh; do
  if [ -x "$here/fleet-$cmd.$ext" ]; then
    shift
    exec "$here/fleet-$cmd.$ext" "$@"
  fi
done
# one word = a machine → the shell; more words are connect's own options
[ $# -eq 1 ] && shell_ok && exec "$here/fleet-shell.sh" "$@"
exec "$here/fleet-connect.py" --enter "$@"
