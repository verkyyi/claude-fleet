#!/bin/sh
# fleet [machine] | fleet <command> [args] — the client-side entry point a
# person types on their own computer (claude-fleet#1413, #1470).
#
#   fleet                       sign in if needed (QR once; the device renews
#                               after that) and open the CLIENT (#3003, EPIC
#                               #2999): one small loop and one ssh to your home
#                               machine, which draws the list, the bar and the
#                               session (fleet-thin.py — no tmux here); ⌘Q or
#                               closing the terminal ends it
#   fleet --thin [<session>]    the same, opening on that session first
#   fleet mac-a                 the same, with mac-a as your home machine
#   fleet quit                  what the OLD client (deleted in #3008) may still
#                               run in the background here goes — its servers,
#                               loops and lease (fleet-client-retire.sh); the
#                               sessions keep running on their machines
#   fleet status                whether anything of fleet runs here in the
#                               background, then who is signed in and where
#   fleet login                 scan for a 12-hour connection certificate
#   fleet login renew           renew it with this device's key, no scan
#                               — the login also registers this computer as an
#                               untrusted, coordinate-only node (#2212)
#   fleet logout [--keep-node]  sign out; the node leaves too unless kept
#   fleet shell [machine] [--print]
#                               straight to the home machine's command line
#                               ($HOME), no 看台 — the emergency way in; the hub
#                               down, the route remembered here; --print: one
#                               ssh line for a phone's ssh app (EPIC T651 C5)
#   fleet connect [machine]     route + ssh only — what the client runs inside;
#                               for debugging (`fleet connect mac-a --print`)
#   fleet connect --proxy <m>   ssh's ProxyCommand through the hub
#   fleet route [<m> [auto|relay|direct|entry|tailscale|<host[:port]>]]
#                               the route to each machine — measured (auto, the
#                               default) or pinned by you: no measuring, no
#                               switching, a drop reconnects the same way; bare
#                               lists every machine's route + last handshakes
#                               (#2886; ⌘P 连接路线…)
#   fleet host on|off|status|dev  承载: whether this computer also runs sessions (dev: your checkout as the install)
#                               (#1806 — the hub's word for it is node)
#   fleet config [show|add|set|rm|promote|history|restore|people|export|import]
#                               see where each Agent setting comes from (fleet ·
#                               团队 · 个人 · 本机) and change your own (#1860);
#                               export / import a layer as one file (#1865)
#   fleet --test-identity …     the client as the TEST identity (#1931): its
#                               own lease beside yours — takes nothing over,
#                               never where you are; the default inside a
#                               session (FLEET_CLIENT_IDENTITY=test)
#   fleet users [list|add <name>|remove <name>]
#                               who may sign in to the hub with GitHub (#1986)
#   fleet hub set <key> <value> the hub's settings, at once, audited (#1986);
#                               fleet hub settings | get <key> | unset <key>
#   fleet hub invite [github]   an install command that lets one newcomer in (#2261)
#   fleet release [--to <sha>] [--dry-run] | --rollback
#                               (on a fleet machine) the release: CI green →
#                               move stable → the hub, every machine and this one
#                               follow, each checked; stops at the first that
#                               does not, `--rollback` moves stable back (#2483)
#   fleet release stats [--days N] [--json]
#                               the release ledger (#3140): merge → every machine,
#                               releases an hour, macOS queue (the operator's)
#   fleet claude|codex [--node mac-a] [a first sentence…]
#                               a new session in your home directory on a
#                               fleet machine, the client onto it (#2264)
#   fleet claude|codex --here [args]
#                               a session on THIS computer through its
#                               credential proxy, no credential in it (#2136)
#   fleet run claude|codex [args]
#                               旧写法 of `fleet claude|codex --here`
#   fleet ls [--all] [--json]   your sessions: 名称 · 单号 · 机器 · Agent · 剩余 ·
#                               模型 · Effort · 状态 · PR · 回收方式 (#2365, #2431
#                               — the menu's, as a command; test rows too,
#                               `fleet close --test` closes them all — #2505);
#                               --all adds the 已结束 ones (#2565)
#   fleet show|open <会话>      one session's fields · the client onto it
#   fleet rename <会话> <新名>  · fleet close <会话> [--yes]
#   fleet reap <会话> <方式>    · fleet answer [<会话>] [<回答>]
#   fleet notices [--json]      ⌘P's ✦ 消息 — every message in the one book (T675, T701)
#                               <会话> = a name (or part), #单号, or the key;
#                               two matches = the candidates and exit 4, never
#                               a guess. `fleet open <url|:port|file>` and
#                               `fleet show <file>` are what they were
#
#                    fleet claude          fleet claude --here
#     runs on        a fleet machine       this computer
#     sees files of  that machine ($HOME)  this computer (the cwd)
#     after you quit keeps running         ends with the agent
#     other device   can pick it up        no
#     on the list    yes                   no
#
#   fleet account add --provider claude|codex --label <name>
#                               on a fleet machine: sign a new subscription in
#                               and hand it to the hub, no copy kept (#2084)
#   fleet cred-scan scan        counts what a session here can reach (#2136)
#   fleet doctor                with only the client here: its `fleet` row
#                               (version, hub, tmux, cert — #1722) and its
#                               `能力` row (基础 · 承载, #1806), cert and
#                               tls; the Agent configuration (hooks · skills ·
#                               MCP · mod, #1725) is 承载's (#4826)
#   手机连 fleet               <入口>/fleet/keys in a phone's browser (#3069):
#                               your address name, the four things Termius asks
#                               for, add or revoke a key, move your home
#
# The client is the ONLY way in (issue #1628): there is no fallback to ssh-ing
# into a machine's own list. It needs a terminal; without one `fleet` says so
# and exits non-zero. The old two-pane client (fleet-shell.sh, `fleet --old`,
# FLEET_CLIENT=shell) is gone (issue #3008): every client road here opens fleet-thin.py.
# A MANAGED machine (/var/db/fleet-node/machine.env, issue #2702) is no one's
# resident client — nothing opens at an ssh login — but a `fleet` typed there
# opens the client ON THE MACHINE for this ssh alone (issues #2720, #3006): see
# node_hosted below.
#
# Each command is its own script beside this one, `fleet-<command>.py` or
# `fleet-<command>.sh`, so adding one is adding a file, not editing here. A
# first word that is not a command is a machine name.
here=$(cd "$(dirname "$0")" && pwd -P)
# tmux's static build the install line put here when this computer had no
# tmux (#2260) comes first, for `fleet` and everything it runs
_fv="${XDG_DATA_HOME:-$HOME/.local/share}/claude-fleet-vendor/bin"
if [ -x "$_fv/tmux" ]; then case ":$PATH:" in *":$_fv:"*) ;; *) PATH="$_fv:$PATH"; export PATH ;; esac; fi
unset _fv
# the python the install line recorded (#2878: Apple's on macOS, which verifies
# the hub against the system keychain) — first on PATH for every python3 below
_fp="${FLEET_CONF_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-fleet}/pybin"
if [ -x "$_fp/python3" ]; then case ":$PATH:" in *":$_fp:"*) ;; *) PATH="$_fp:$PATH"; export PATH ;; esac; fi
unset _fp
# node_hosted — a managed machine (issue #2702) runs sessions and services, and an
# ssh login there opens nothing. But a person away from their own device (a
# phone's Termius, someone else's computer, an ssh-only place) may still TYPE
# `fleet` there (issue #2720): the client on the machine — the SAME code as on a
# device, taken from the machine's runtime (`current/`: no mirror copied under
# ~/.cache, no update path of its own, no LaunchAgent), its logs in a temp dir,
# `fleet-thin.py --local`: this machine is home, no hub asked, no ssh back to
# itself (issue #3006). Its where says via=node-hosted (show / open hand a path or
# a link). A session's test of the client (FLEET_CLIENT_IDENTITY=test) and
# FLEET_NODE_CLIENT=1 (the operator's hatch) keep the device client's road.
THIN_BIN=$here
if [ -e "${FLEET_NODE_STATE:-/var/db/fleet-node}/machine.env" ] \
   && [ "${FLEET_CLIENT_IDENTITY:-}" != test ] && [ "${FLEET_NODE_CLIENT:-0}" != 1 ]; then
  FLEET_NODE_HOSTED=1
  FLEET_SHELL_CACHE=${FLEET_NODE_HOSTED_CACHE:-${TMPDIR:-/tmp}/fleet-node-client-$(id -u)}
  export FLEET_NODE_HOSTED FLEET_SHELL_CACHE
  _rt=${FLEET_NODE_RUNTIME:-/Library/Application Support/claude-fleet/current}
  [ -f "$_rt/bin/fleet-thin.py" ] && THIN_BIN=$(cd "$_rt/bin" && pwd)
  unset _rt
fi
# managed — the one line a client opened on a managed machine says first
managed() {
  [ "${FLEET_NODE_HOSTED:-0}" = 1 ] || return 0
  _me=$(hostname -s 2>/dev/null); _me=${_me%%.*}
  # no hub for this login (本机模式, `fleet-install.sh --no-hub` — issue #4074):
  # there is no 入口 to install from, so the line names none
  _hub=${FLEET_HUB_URL:-}
  [ -n "$_hub" ] || _hub=$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}FLEET_HUB_URL=//p' \
    "${FLEET_CONF_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-fleet}/fleet.conf" 2>/dev/null | tail -n 1 | tr -d "\"' ")
  if [ -n "$_hub" ]; then
    echo "fleet · 客户端在 ${_me:-这台托管机器} 上运行；平时请在自己设备上用 fleet（装：curl -fsSL <入口>/install | sh）。" >&2
  else
    echo "fleet · 客户端在 ${_me:-这台托管机器} 上运行（本机模式，不连入口）。" >&2
  fi
  # a resident client from before #2702 still here: how to clear it
  _sc="${XDG_CACHE_HOME:-$HOME/.cache}/claude-fleet/shell"
  if [ -d "$_sc/bin" ] || tmux -L fleet-shell has-session -t =fleet-shell 2>/dev/null; then
    echo "fleet · 这台上还留着旧的常驻客户端（${_sc}）：不用了 sudo bash $here/fleet-node-shell-retire.sh --login $(id -un) 清掉。" >&2
  fi
  unset _me _sc _hub
}
# client [fleet-thin.py's args] — the client (fleet-thin.py, issue #3003), which
# reconnects, re-homes and picks up a new version by itself — the same update
# check first, once — or one line on why it cannot open here and a non-zero exit
client() {
  managed
  # FLEET_CLIENT=shell chose the old client (issue #3007); it is gone, so it is
  # said, never obeyed — fleet-conf.sh migrate comments the line out (#3008)
  [ "${FLEET_CLIENT:-}" = shell ] && echo 'fleet · FLEET_CLIENT=shell 选的旧客户端已删除（#3008）；打开的是客户端。' >&2
  if [ "${FLEET_NODE_HOSTED:-0}" = 1 ]; then
    exec python3 "$THIN_BIN/fleet-thin.py" --local "$@"
  fi
  # what the deleted two-pane client still runs here (issue #4283): its warm loop
  # kept ~120 ssh lines open, each a hub relay on the relay route, until the hub
  # said TOO_MANY — and what any client left with no parent and no terminal (an
  # ssh master, a disowned loop: issue #4827) — taken away in the background,
  # never one a person looks at (fleet-client-retire.sh --if-unattached);
  # FLEET_RETIRE_OLD=0 leaves it
  if [ "${FLEET_RETIRE_OLD:-1}" != 0 ] && [ -f "$here/fleet-client-retire.sh" ]; then
    ( bash "$here/fleet-client-retire.sh" stop --quiet --if-unattached </dev/null >/dev/null 2>&1 & )
  fi
  # keep up with the hub (issue #1722): an installed client asks it, at most
  # hourly, for a newer client and the team's defaults; 3 = files switched,
  # so the new `fleet` opens instead (once — FLEET_CLIENT_UPDATED). The client
  # on a managed machine moves with the machine's runtime instead (#2720)
  if [ -z "${FLEET_CLIENT_UPDATED:-}" ] && [ -x "$here/fleet-client-update.sh" ]; then
    "$here/fleet-client-update.sh" start
    if [ $? -eq 3 ]; then
      FLEET_CLIENT_UPDATED=1; export FLEET_CLIENT_UPDATED
      exec "$here/fleet" --thin "$@"
    fi
  fi
  exec python3 "$here/fleet-thin.py" "$@"
}
# a session's test or drill connects as the test identity (#1931): the flag
# travels as FLEET_CLIENT_IDENTITY, which fleet-client-lease.py reads
if [ "${1-}" = --test-identity ]; then
  FLEET_CLIENT_IDENTITY=test; export FLEET_CLIENT_IDENTITY
  shift
fi
cmd=${1-}
case $cmd in
  -h|--help|help)
    sed -n "2,$(awk '/^here=/ { print NR - 1; exit }' "$0")p" "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  '')
    client ;;
  --thin)
    shift
    client "$@" ;;
  # the old client's way back (issue #3007) went with it (#3008): said once, then the client
  --old)
    shift
    echo 'fleet · 旧客户端已删除（#3008），fleet --old 不再有；打开的是客户端。' >&2
    client "$@" ;;
  -*)
    echo "fleet · 不认识的选项 ${cmd}；选路调试用 fleet connect $* （fleet --help）" >&2
    exit 2 ;;
esac
# `fleet doctor` with only the client here: no fleet-doctor.sh beside — the
# client's own row (issue #1722: version, hub, tmux, cert), then the Agent
# configuration package's (issue #1725) where an older client left it — the
# client installs none since #4826 (承载's). Non-zero when either warns.
if [ "$cmd" = doctor ] && [ ! -x "$here/fleet-doctor.sh" ] \
   && { [ -x "$here/fleet-client-update.sh" ] || [ -f "$here/fleet-agent-bundle.py" ]; }; then
  shift
  rc=0
  if [ -x "$here/fleet-client-update.sh" ]; then
    r=$("$here/fleet-client-update.sh" doctor); tab=$(printf '\t')
    printf '  %-4s  %-8s %s\n' "${r%%"$tab"*}" fleet "${r#*"$tab"}"
    case $r in WARN*) rc=1 ;; esac
  fi
  # 能力 (issue #1806): what this computer does — 基础, and 承载 when it hosts
  if [ -f "$here/fleet-conf.sh" ]; then
    if [ "$(bash "$here/fleet-conf.sh" host 2>/dev/null)" = 1 ]; then w='基础 · 承载'; else w='基础 · 承载 未开（fleet host on）'; fi
    printf '  PASS  能力     %s\n' "$w"
  fi
  # cert (issue #2457): the certificate's principals, validity, and whether the hub accepts it
  if [ -f "$here/fleet-connect.py" ] && r=$(python3 "$here/fleet-connect.py" --cert-check 2>/dev/null) && [ -n "$r" ]; then
    tab=$(printf '\t')
    printf '  %-4s  %-8s %s\n' "${r%%"$tab"*}" cert "${r#*"$tab"}"
    case $r in PASS*) ;; *) rc=1 ;; esac
  fi
  # tls (issue #2878): can the python fleet runs on verify the hub's certificate
  if [ -f "$here/fleet-connect.py" ] && r=$(python3 "$here/fleet-connect.py" --tls-check 2>/dev/null) && [ -n "$r" ]; then
    tab=$(printf '\t')
    printf '  %-4s  %-8s %s\n' "${r%%"$tab"*}" tls "${r#*"$tab"}"
    case $r in FAIL*) rc=1 ;; esac
  fi
  # background (issue #4827; the `old` row of #3008 before it): what fleet still
  # runs here with nobody looking — the deleted two-pane client, an ssh master
  # or loop a client left — and the files an update left beside the install;
  # `fleet quit` stops the processes, the next `fleet` clears the files
  if [ -f "$here/fleet-client-retire.sh" ] && r=$(bash "$here/fleet-client-retire.sh" background 2>/dev/null) && [ -n "$r" ]; then
    tab=$(printf '\t')
    printf '  %-4s  %-8s %s\n' "${r%%"$tab"*}" background "${r#*"$tab"}"
    case $r in PASS*) ;; *) rc=1 ;; esac
  fi
  if [ -f "$here/fleet-agent-bundle.py" ]; then
    python3 "$here/fleet-agent-bundle.py" doctor --root "$here/.." "$@" || rc=1
  fi
  exit $rc
fi
# a word whose scripts the client package only SERVES (issue #4826, EPIC #4823
# C3) — the admin's: fetched here on first use (fc_served, from
# where this client came from), then run as before. A full install has them.
_need=''
case $cmd in
  users) _need='bin/fleet-users.py bin/fleet-hub-admin.py' ;;
  hub) _need='bin/fleet-hub.py bin/fleet-hub-admin.py' ;;
  release) [ "${2:-}" = stats ] && _need='bin/fleet-release-stats.py bin/fleet-hub-admin.py' ;;
esac
if [ -n "$_need" ] && [ -f "$here/fleet-client-lib.sh" ]; then
  # shellcheck source=fleet-client-lib.sh
  . "$here/fleet-client-lib.sh"
  # shellcheck disable=SC2086  # the paths are words
  fc_served "$here/.." $_need || { echo "fleet · fleet $cmd 要的文件没取到：$FC_WHY" >&2; exit 1; }
fi
unset _need
# `fleet release stats` (issue #3140): the release ledger's numbers, on a client
# too — `fleet release` itself is the node's fleet-release.sh
if [ "$cmd" = release ] && [ "${2:-}" = stats ] && [ -f "$here/fleet-release-stats.py" ]; then
  shift 2
  exec python3 "$here/fleet-release-stats.py" "$@"
fi
# `fleet claude` / `fleet codex` (issue #2264): a session in one command — never
# the node's own launchers of the same name (fleet-claude.sh / fleet-codex.sh)
case $cmd in
  claude|codex)
    # the one-session view rides a device's client; on a managed machine (#2720)
    # `fleet` opens the client there, `--here` a session on this machine
    case " $* " in *' --here '*) ;; *)
      if [ "${FLEET_NODE_HOSTED:-0}" = 1 ]; then
        echo "fleet · 托管机器上没有 fleet $cmd 的单会话视图：敲 fleet 在这台上开客户端，或 fleet $cmd --here 在这台开会话。" >&2
        exit 3
      fi ;;
    esac
    exec "$here/fleet-home-session.sh" "$@" ;;
  # the home's command line with no 看台 (EPIC T651 C5): the emergency way in,
  # on the 看台's own certificate and route — the remembered one when the hub
  # does not answer
  shell)
    shift
    exec python3 "$here/fleet-shell.py" "$@" ;;
  # what the old client left running in the background (issue #3008); the
  # client itself lives in its terminal — ⌘Q or closing it ends it
  quit)
    shift
    exec bash "$here/fleet-client-retire.sh" stop "$@" ;;
  status)
    # anything of fleet in the background, then who is signed in and where (#2577)
    if bash "$here/fleet-client-retire.sh" running; then
      rc=0; sh "$here/fleet-ui-lang.sh" t retire_left
    else
      rc=1; sh "$here/fleet-ui-lang.sh" t retire_none
    fi
    echo
    bash "$here/fleet-client-who.sh"
    exit $rc ;;
  # the sessions from the command line (issue #2365) — `fleet open <url|:port|file>`
  # and `fleet show <file>` still go to fleet-open.sh / fleet-show.sh from there
  ls|show|open|rename|close|reap|answer|notices)
    exec python3 "$here/fleet-session-cli.py" "$@" ;;
  # a background service / scheduled task, on whichever machine holds it — the
  # hub's service_control (issue #2527); add · rm · ls · logs · cred stay the
  # machine's own fleet-service.sh / fleet-task.sh
  service|task)
    case ${2:-} in
      stop|start|restart|run|schedule) exec python3 "$here/fleet-session-cli.py" "$@" ;;
    esac ;;
esac
# what runs the Agent on THIS computer is 承载's (issue #4826, EPIC #4823
# decision 1): with only the client here the word says so — never a machine name
case $cmd in
  config|run|cred-scan)
    if [ ! -f "$here/fleet-$cmd.py" ] && [ ! -f "$here/fleet-$cmd.sh" ]; then
      echo "fleet · fleet $cmd 管这台电脑上的 Agent，开了承载才有：fleet host on" >&2
      exit 3
    fi ;;
esac
for ext in py sh; do
  if [ -x "$here/fleet-$cmd.$ext" ]; then
    shift
    exec "$here/fleet-$cmd.$ext" "$@"
  fi
done
# a word that is no command = a machine → the client, with it as home, always
if [ $# -gt 1 ]; then
  echo "fleet · fleet $1 只开客户端；选路调试用 fleet connect $* （fleet --help）" >&2
  exit 2
fi
client --home "$1"
