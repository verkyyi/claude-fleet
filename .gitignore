logs/
fleet.conf
*.log
.DS_Store
# stray unix-domain sockets from ad-hoc testing (e.g. a leftover ./fake) — these
# never belong in the tree and only clutter `git status`
*.sock
/fake
__pycache__/

# the web chat page build (issue #3637): dependencies stay local; dist/ is committed
extras/web-chat/ui/node_modules/

# stray files a shell slip once committed at the root (issue #3576)
/trap
/Authorization:*
tokenledger/hub/web/docs/*
!tokenledger/hub/web/docs/.gitkeep
# the website build (issue #3584): bin/site-build.sh writes it before the image build
tokenledger/hub/web/site/*
!tokenledger/hub/web/site/.gitkeep
# the new console (issue #3925): bin/web-console-pack.sh copies extras/web-console/dist
tokenledger/hub/web/console/*
!tokenledger/hub/web/console/.gitkeep
# the way-in pages' theme (issue #3932): bin/web-console-pack.sh copies extras/fleet-theme
tokenledger/hub/web/theme/*
!tokenledger/hub/web/theme/.gitkeep
