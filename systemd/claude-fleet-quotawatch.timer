# Fires claude-fleet-quotawatch.service. Parity with the launchd plist:
# StartInterval=60 + RunAtLoad=true → run ~15s after the user manager comes up,
# then every 60s. Install: `systemctl --user enable --now
# claude-fleet-quotawatch.timer`.
[Unit]
Description=claude-fleet quota watch timer (every 60s)

[Timer]
OnStartupSec=15
OnUnitActiveSec=60
AccuracySec=5s

[Install]
WantedBy=timers.target
