# claude-fleet quota watch — Linux systemd user unit (parity with launchd
# com.claude-fleet.quotawatch). Oneshot driven by the .timer. The ccquota-driven
# PRE-EMPTIVE account rotation (warn at FLEET_ACCOUNT_WARN_PCT, bench + move at
# FLEET_ACCOUNT_CEILING) on its OWN 60s tick, independent of the collector's gh
# latency (issue #551). No-op without an accounts pool + CCQUOTA_HUB_URL.
# See bin/fleet-quotawatch.sh.
[Unit]
Description=claude-fleet ccquota pre-emptive account rotation watch

[Service]
Type=oneshot
ExecStart=/bin/bash __HOME__/.claude/fleet/bin/fleet-quotawatch.sh
Environment=HOME=__HOME__
Environment=LANG=en_US.UTF-8
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
StandardOutput=null
StandardError=append:__HOME__/.claude/fleet/logs/quotawatch.systemd.log
