# claude-fleet install-sync daemon — Linux systemd user unit (parity with launchd
# com.claude-fleet.install-sync). Oneshot driven by claude-fleet-install-sync.timer.
# Keeps THIS login's live install (~/.claude/fleet) fast-forwarded to
# refs/tags/stable on the public repo (issue #1120): fetch the tag over https
# (no credentials), and when nothing on this login's fleets is busy,
# `merge --ff-only` -> bin/fleet-install-apply.sh -> bin/fleet-doctor.sh, rolling
# back to the previous version if the doctor gains a FAIL line. Never moves
# backward, never touches an install with tracked local changes. ON by default
# per login; opt out with FLEET_INSTALL_SYNC=0.
[Unit]
Description=claude-fleet install-sync daemon (follow refs/tags/stable when idle; roll back on a failed doctor)

[Service]
Type=oneshot
ExecStart=/bin/bash __HOME__/.claude/fleet/bin/fleet-install-sync.sh
Environment=HOME=__HOME__
Environment=LANG=en_US.UTF-8
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
StandardOutput=null
StandardError=append:__HOME__/.claude/fleet/logs/install-sync.systemd.log
