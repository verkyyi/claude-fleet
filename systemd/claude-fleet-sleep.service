[Unit]
Description=claude-fleet idle worker hibernation

[Service]
Type=oneshot
ExecStart=/bin/bash __HOME__/.claude/fleet/bin/fleet-sleep-daemon.sh
Environment=HOME=__HOME__
Environment=LANG=en_US.UTF-8
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
StandardOutput=append:__HOME__/.claude/fleet/logs/sleep.log
StandardError=append:__HOME__/.claude/fleet/logs/sleep.systemd.log
