# claude-fleet — a short sample of the settings most people touch.
# GENERATED from conf/fleet.conf.reference by bin/fleet-conf-example.sh; do not
# edit by hand. Every key, its default and its help: conf/fleet.conf.reference.
#
# Your settings live in $FLEET_CONF_DIR/fleet.conf (default
# ~/.config/claude-fleet/fleet.conf; plain shell, assignments only). The config
# panel (prefix+c) edits them; `fleet doctor` reads them back. A line left
# commented keeps the default shown.

# ── identity ──
# GitHub repo
FLEET_REPO="you/your-repo"
# Base checkout path
FLEET_MAIN="$HOME/projects/your-repo"
# Base branch (locked)
FLEET_BASE_BRANCH="main"
# Public SSH host
#FLEET_SSH_PUBLIC_HOST=ssh.example.com
# Public SSH port
#FLEET_SSH_PUBLIC_PORT=22
# Public-entry probe host
#FLEET_SSH_PROBE_HOST=my-vps

# ── janitor ──
# Follow stable automatically
#FLEET_INSTALL_SYNC=1

# ── spawn ──
# Worker model
#FLEET_MODEL="opus"
# Model-cap fallback
#FLEET_MODEL_FALLBACK="opus"
# Worker agent CLI
#FLEET_AGENT="claude"
# Jump to new worker windows
#FLEET_SPAWN_FOCUS=0
# Warm scratch sessions
#FLEET_SCRATCH_POOL=1
# Cross-machine pre-spawn dedup
#FLEET_PRESPAWN_DEDUP=1
# Auto-merge method
#FLEET_MERGE_METHOD="squash"
# Tap-first option menus
#FLEET_TAP_FIRST=0
# Worker seed prompt
#FLEET_WORKER_PROMPT="Implement and verify per the repo conventions"

# ── caps ──
# Max sessions — all fleets
FLEET_GLOBAL_MAX_SESSIONS=0
# Max sessions — this fleet
#FLEET_MAX_SESSIONS=0

# ── backlog ──
# Default milestone for filed issues
#FLEET_DEFAULT_MILESTONE=""

# ── bridge ──
# Relay issue comments to worker
#FLEET_ISSUE_BRIDGE=0
# Cleanup daemon (reap after merges)
#FLEET_CLEANUP=1
# Fresh status via gh webhook forward
#FLEET_WEBHOOK=0

# ── cache ──
# GitHub cache lifetime
#FLEET_GH_TTL=90
# PR status refresh
#FLEET_PR_REFRESH_INTERVAL=15

# ── status ──
# Worker task sidebar
#FLEET_SIDEBAR=1
# Tmux UI language
#FLEET_UI_LANG=auto
# Closing a task lands on the next task
#FLEET_CLOSE_LANDS_NEXT=1
# ⌂/F9 go to the task bar first
#FLEET_HOME_SIDEBAR_FIRST=1

# ── notify ──
# Notification command
#FLEET_NOTIFY_CMD="$HOME/.claude/fleet/extras/wecom-webhook-notify.sh"
